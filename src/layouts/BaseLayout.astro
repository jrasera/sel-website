---
import SkipLink from '../components/nav/SkipLink.astro';
import Header from '../components/nav/Header.astro';
import Footer from '../components/nav/Footer.astro';
import Starfield from '../components/ui/Starfield.astro';
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/base.css';
import '../styles/motion.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Strategic Engineering Laboratory</title>
    <meta name="description" content={description} />
    <link rel="preload" href="/fonts/fraunces-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/public-sans-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-mono-400.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <Starfield />
    <SkipLink />
    <Header currentPath={currentPath} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script src="../scripts/reveal.ts"></script>
  </body>
</html>
