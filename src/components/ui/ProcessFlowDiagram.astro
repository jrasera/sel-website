---
interface Props {
  nodes: { title: string }[];
}

const { nodes } = Astro.props;
---

{/* A sequence read along an axis: each stage is a division on one rule, not a
    pill in a chain of pills. Wrapping is the responsive behaviour. */}
<ol class="flow" aria-hidden="true">
  {
    nodes.map((node, i) => (
      <li>
        <span class="label flow-n">{String(i + 1).padStart(2, '0')}</span>
        <span class="flow-title">{node.title}</span>
      </li>
    ))
  }
</ol>

<style>
  .flow {
    list-style: none;
    margin: 0 0 var(--space-2);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .flow li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 12px 22px;
    border-left: 1px solid var(--rule);
  }

  .flow li:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .flow-n {
    color: var(--signal);
  }

  .flow-title {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 100, 'wght' 560;
    font-size: 0.92rem;
  }
</style>
