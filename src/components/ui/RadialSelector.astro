---
interface Item {
  n: string;
  heading: string;
  description: string;
}

interface Props {
  hubLabel: string;
  items: Item[];
  size?: 'default' | 'large';
}

const { hubLabel, items, size = 'default' } = Astro.props;

const CENTER = 50;
const ORBIT = items.length > 5 ? 36 : 32;
const HUB_R = items.length > 5 ? 9 : 10;

const points = items.map((item, i) => {
  const angle = (2 * Math.PI * i) / items.length - Math.PI / 2;
  const x = CENTER + ORBIT * Math.cos(angle);
  const y = CENTER + ORBIT * Math.sin(angle);
  return { ...item, x, y };
});
---

<div class:list={['radial-selector', size]} data-radial-selector>
  <div class:list={['radial-wrap', size]}>
    <svg class="bg-svg" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      {points.map((p) => <line class="spoke-line" x1={CENTER} y1={CENTER} x2={p.x} y2={p.y} />)}
      <circle class="hub" cx={CENTER} cy={CENTER} r={HUB_R} />
      <text class="hub-label" x={CENTER} y={CENTER}>{hubLabel}</text>
    </svg>

    {
      points.map((p, i) => (
        <button
          type="button"
          class="node-btn"
          data-index={i}
          aria-label={`${p.n}. ${p.heading}`}
          style={`left:${p.x}%; top:${p.y}%`}
        >
          <span class="node-n mono-label" aria-hidden="true">{p.n}</span>
          <span class="node-heading" aria-hidden="true">{p.heading}</span>
        </button>
      ))
    }
  </div>

  <div class="detail-panel" aria-live="polite" hidden>
    <span class="detail-n mono-label"></span>
    <h3 class="detail-heading"></h3>
    <p class="detail-description"></p>
  </div>

  <ol class="item-list">
    {
      items.map((item, i) => (
        <li data-index={i}>
          <span class="item-n mono-label" aria-hidden="true">{item.n}</span>
          <h3>{item.heading}</h3>
          <p>{item.description}</p>
        </li>
      ))
    }
  </ol>
</div>

<script>
  function initRadialSelector(root: Element) {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('.node-btn'));
    const list = root.querySelector<HTMLElement>('.item-list');
    const panel = root.querySelector<HTMLElement>('.detail-panel');
    if (!buttons.length || !list || !panel) return;

    const items = Array.from(list.querySelectorAll<HTMLElement>('li'));
    const panelN = panel.querySelector('.detail-n');
    const panelHeading = panel.querySelector('.detail-heading');
    const panelDescription = panel.querySelector('.detail-description');
    if (!panelN || !panelHeading || !panelDescription) return;

    function activate(index: number) {
      const item = items[index];
      if (!item) return;
      panelN!.textContent = item.querySelector('.item-n')?.textContent ?? '';
      panelHeading!.textContent = item.querySelector('h3')?.textContent ?? '';
      panelDescription!.textContent = item.querySelector('p')?.textContent ?? '';
      for (const btn of buttons) {
        btn.classList.toggle('is-active', Number(btn.dataset.index) === index);
      }
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => activate(Number(btn.dataset.index)));
    });

    panel.hidden = false;
    list.hidden = true;
    activate(0);
  }

  document.querySelectorAll('[data-radial-selector]').forEach(initRadialSelector);
</script>

<style>
  .radial-wrap {
    position: relative;
    aspect-ratio: 1;
    width: min(100%, 440px);
    margin: 0 auto;
  }

  .radial-wrap.large {
    width: min(100%, 640px);
  }

  .bg-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .spoke-line {
    stroke: var(--line);
    stroke-width: 0.5;
  }

  .hub {
    fill: var(--accent-soft);
    stroke: var(--accent);
    stroke-width: 0.6;
  }

  .hub-label {
    fill: var(--text);
    font-family: var(--font-mono);
    font-size: 3.6px;
    letter-spacing: 0.04em;
    text-anchor: middle;
    dominant-baseline: central;
  }

  .node-btn {
    position: absolute;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    min-width: 64px;
    max-width: 128px;
    padding: 10px 14px;
    background: var(--bg2);
    border: 1.5px solid var(--line);
    border-radius: 12px;
    cursor: pointer;
    font-family: inherit;
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .node-btn:hover {
    border-color: var(--accent);
    transform: translate(-50%, -50%) translateY(-2px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.35), 0 0 16px var(--accent-soft);
  }

  .node-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .node-btn.is-active {
    background: var(--accent-soft);
    border-color: var(--accent);
  }

  .node-n {
    color: var(--accent);
    font-size: 0.65rem;
  }

  .node-heading {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.78rem;
    line-height: 1.2;
    text-align: center;
    color: var(--text);
  }

  .detail-panel {
    margin: var(--space-2) auto 0;
    max-width: 640px;
    background: var(--bg2);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 26px 28px;
  }

  .detail-n {
    color: var(--accent);
  }

  .detail-heading {
    font-size: 1.2rem;
    margin: 10px 0 10px;
  }

  .detail-description {
    color: var(--muted);
    margin: 0;
  }

  .item-list {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }

  .item-list[hidden] {
    display: none;
  }

  .item-list li {
    background: var(--bg2);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 20px 22px;
  }

  .item-n {
    color: var(--accent);
  }

  .item-list h3 {
    font-size: 1.05rem;
    margin: 8px 0 6px;
  }

  .item-list p {
    color: var(--muted);
    margin: 0;
    font-size: 0.92rem;
  }

  @media (max-width: 37.5em) {
    .radial-wrap {
      aspect-ratio: auto;
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .bg-svg {
      display: none;
    }

    .node-btn {
      position: static;
      transform: none;
      flex-direction: row;
      align-items: center;
      max-width: none;
      width: 100%;
      justify-content: flex-start;
      text-align: left;
    }

    .node-btn:hover {
      transform: none;
    }
  }
</style>
