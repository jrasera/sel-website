---
import StepSchematic from '../method/StepSchematic.astro';

interface Item {
  n: string;
  heading: string;
  description: string;
  figure: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<div class="sequence" data-sequence>
  <ol class="rail">
    {
      items.map((item, i) => (
        <li class="step" data-index={i}>
          {/* Number and heading are both visible text at every width — the
              pass-2 rail showed numbered dots only, so nothing could be read
              without clicking. The button is only rendered as a control when
              scripting is available; without it the plain heading stands. */}
          <button type="button" class="step-btn" data-index={i}>
            <span class="label step-n">{item.n}</span>
            <span class="step-h">{item.heading}</span>
          </button>
          <h3 class="step-static">
            <span class="label step-n">{item.n}</span>
            <span class="step-h">{item.heading}</span>
          </h3>
          <div class="step-body">
            <p>{item.description}</p>
            <StepSchematic kind={item.figure} />
          </div>
        </li>
      ))
    }
  </ol>

  <div class="detail" aria-live="polite">
    <span class="detail-n">01</span>
    <h3 class="detail-h"></h3>
    <div class="detail-body"></div>
  </div>
</div>

<script>
  function initSequence(root: Element) {
    const steps = Array.from(root.querySelectorAll<HTMLElement>('.step'));
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('.step-btn'));
    const detail = root.querySelector<HTMLElement>('.detail');
    const detailN = root.querySelector<HTMLElement>('.detail-n');
    const detailH = root.querySelector<HTMLElement>('.detail-h');
    const detailBody = root.querySelector<HTMLElement>('.detail-body');
    if (!steps.length || !detail || !detailN || !detailH || !detailBody) return;

    function activate(index: number) {
      const step = steps[index];
      if (!step) return;
      detailN!.textContent = step.querySelector('.step-n')?.textContent ?? '';
      detailH!.textContent = step.querySelector('.step-h')?.textContent ?? '';
      const body = step.querySelector('.step-body');
      if (body) detailBody!.replaceChildren(...Array.from(body.cloneNode(true).childNodes));
      steps.forEach((s, i) => s.classList.toggle('is-active', i === index));
      buttons.forEach((b, i) => {
        if (i === index) b.setAttribute('aria-current', 'true');
        else b.removeAttribute('aria-current');
      });
    }

    buttons.forEach((btn, i) => {
      // The accessible name has to carry the number and the heading together.
      btn.setAttribute('aria-label', `${steps[i].querySelector('.step-n')?.textContent}. ${steps[i].querySelector('.step-h')?.textContent}`);
      btn.addEventListener('click', () => activate(i));
      btn.addEventListener('keydown', (event) => {
        const dir = event.key === 'ArrowDown' ? 1 : event.key === 'ArrowUp' ? -1 : 0;
        if (!dir) return;
        event.preventDefault();
        const next = (i + dir + buttons.length) % buttons.length;
        buttons[next].focus();
        activate(next);
      });
    });

    root.classList.add('is-enhanced');
    activate(0);
  }

  document.querySelectorAll('[data-sequence]').forEach(initSequence);
</script>

<style>
  .sequence {
    display: grid;
    gap: var(--space-3);
  }

  .rail {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }

  /* A real axis with a tick per step, not a decorative line. */
  .rail::before {
    content: '';
    position: absolute;
    left: 0;
    top: 14px;
    bottom: 14px;
    width: 1px;
    background: var(--rule);
  }

  .step {
    position: relative;
    padding-left: 24px;
  }

  .step::before {
    content: '';
    position: absolute;
    left: -3px;
    top: 25px;
    width: 7px;
    height: 1px;
    background: var(--rule);
  }

  .step-btn,
  .step-static {
    display: flex;
    align-items: baseline;
    gap: 14px;
    width: 100%;
    margin: 0;
    padding: 13px 0;
    text-align: left;
    background: none;
    border: 0;
    color: inherit;
    font: inherit;
  }

  .step-btn {
    cursor: pointer;
  }

  .step-h {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 104, 'wght' 560;
    font-size: 1.02rem;
    line-height: 1.25;
    color: var(--trace);
    transition: color 0.18s ease;
  }

  .step-btn:hover .step-h {
    color: var(--text);
  }

  .step-body {
    padding: 0 0 18px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .step-body p {
    color: var(--trace);
    margin: 0;
    max-width: 62ch;
  }

  .detail {
    display: none;
  }

  .detail-n {
    font-family: var(--font-display);
    font-variation-settings: var(--vf-hero);
    font-variant-numeric: tabular-nums;
    font-size: 2.8rem;
    line-height: 1;
    color: var(--rule-text);
  }

  .detail-h {
    font-size: 1.55rem;
    font-variation-settings: var(--vf-sub);
    margin: 12px 0 0;
  }

  .detail-body {
    margin-top: 14px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .detail-body p {
    color: var(--trace);
    margin: 0;
    max-width: 60ch;
  }

  /* Without JavaScript the buttons are not controls, so they are never shown:
     the static headings and the bodies stand on their own as a plain list. */
  .sequence:not(.is-enhanced) .step-btn {
    display: none;
  }

  /* Below the breakpoint the rail+detail split is off at every JS state, so
     the buttons go and the full list stays — collapsing to headings-only here
     would reproduce the regression this rebuild exists to fix. The two
     thresholds are deliberately adjacent (55.9375em / 56em), never equal. */
  @media (max-width: 55.9375em) {
    .sequence .step-btn {
      display: none;
    }
  }

  @media (min-width: 56em) {
    .sequence.is-enhanced {
      grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
      align-items: start;
    }

    .sequence.is-enhanced .step-static,
    .sequence.is-enhanced .step-body {
      display: none;
    }

    /* Open on two sides — bounded by the rail's axis and a hairline above,
       not enclosed in a panel. */
    .sequence.is-enhanced .detail {
      display: block;
      border-top: 1px solid var(--rule);
      padding-top: 16px;
      position: sticky;
      top: calc(var(--header-h) + 24px);
    }

    .sequence.is-enhanced .step.is-active::before {
      left: -6px;
      top: 22px;
      width: 13px;
      height: 7px;
      background: var(--signal);
    }

    .sequence.is-enhanced .step.is-active .step-h {
      color: var(--text);
      box-shadow: inset 0 -1px 0 var(--signal);
    }

    .sequence.is-enhanced .step.is-active .step-n {
      color: var(--signal);
    }
  }
</style>
