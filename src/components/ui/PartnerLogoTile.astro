---
import type { CollectionEntry } from 'astro:content';

interface Props {
  partner: CollectionEntry<'partners'>;
}

const { partner } = Astro.props;
const { data } = partner;
const Tag = data.url ? 'a' : 'div';
const linkProps = data.url
  ? { href: data.url, target: '_blank', rel: 'noopener noreferrer', 'aria-label': `Visit ${data.name} (opens in new tab)` }
  : {};
---

<Tag class="partner-tile" {...linkProps}>
  {
    data.logo ? (
      <img src={data.logo} alt={data.name} />
    ) : (
      <span class="mono-label placeholder-label">{data.name}</span>
    )
  }
</Tag>

<style>
  .partner-tile {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 168px;
    height: 88px;
    padding: 18px 22px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .partner-tile:hover,
  .partner-tile:focus-visible {
    transform: translateY(-3px);
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.35), 0 0 20px var(--accent-soft);
  }

  .partner-tile img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.75;
    transition: filter 0.25s ease, opacity 0.25s ease;
  }

  .partner-tile:hover img,
  .partner-tile:focus-visible img {
    filter: none;
    opacity: 1;
  }

  .placeholder-label {
    color: var(--surface-warm-muted);
    text-align: center;
  }
</style>
