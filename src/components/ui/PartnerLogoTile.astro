---
import type { CollectionEntry } from 'astro:content';

interface Props {
  partner: CollectionEntry<'partners'>;
}

const { partner } = Astro.props;
const { data } = partner;
const Tag = data.url ? 'a' : 'div';
const linkProps = data.url
  ? { href: data.url, target: '_blank', rel: 'noopener noreferrer', 'aria-label': `Visit ${data.name} (opens in new tab)` }
  : {};
---

<Tag class="partner-logo" {...linkProps}>
  {
    data.logo ? (
      /* A definite size, and no lazy loading: an unsized lazy image in a flex
         row can collapse to 0×0 and never get scheduled to load at all. */
      <img src={data.logo} alt={data.name} width="150" height="46" />
    ) : (
      <span class="label placeholder-label">{data.name}</span>
    )
  }
</Tag>

<style>
  /* No tile. The logos sit directly on the paper band, separated by the
     hairlines their container draws. */
  .partner-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 46px;
    text-decoration: none;
  }

  .partner-logo img {
    width: auto;
    height: 100%;
    max-width: min(150px, 100%);
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.72;
    transition: filter 0.2s ease, opacity 0.2s ease;
  }

  .partner-logo:hover img,
  .partner-logo:focus-visible img {
    filter: none;
    opacity: 1;
  }

  .placeholder-label {
    color: var(--paper-trace);
    text-align: center;
  }
</style>
