---
interface Stage {
  n: string;
  label: string;
}

interface Props {
  stages: Stage[];
  outputs: string[];
}

const { stages, outputs } = Astro.props;

/* Drawn as plot furniture: the stages are divisions on one axis, and the
   outputs are where that axis resolves — the same "paths terminating on a
   right-hand margin" idea as the hero figure, at diagram scale. */
const W = 900;
const H = 210;
const AXIS_Y = 120;
const startX = 40;
const endX = 560;
const stageX = stages.map((_, i) => startX + ((endX - startX) / Math.max(1, stages.length - 1)) * i);
const branchX = 700;

const outputYs = outputs.map((_, i) => {
  const span = 40 * (outputs.length - 1);
  return AXIS_Y - span / 2 + i * 40;
});
---

<figure class="value-chain" aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet">
    <line class="axis" x1={startX} y1={AXIS_Y} x2={endX} y2={AXIS_Y} />

    {
      stageX.map((x, i) => (
        <g>
          <line class="tick" x1={x} y1={AXIS_Y - 7} x2={x} y2={AXIS_Y + 7} />
          <text class="stage-n" x={x} y={AXIS_Y - 18}>
            {stages[i].n}
          </text>
          <text class="stage-label" x={x} y={AXIS_Y + 30}>
            {stages[i].label}
          </text>
        </g>
      ))
    }

    {
      outputYs.map((y) => (
        <path class="branch" d={`M ${endX} ${AXIS_Y} C ${endX + 70} ${AXIS_Y}, ${branchX - 70} ${y}, ${branchX} ${y}`} />
      ))
    }

    {
      outputYs.map((y, i) => (
        <g>
          <rect class="out-marker" x={branchX} y={y - 4} width="8" height="8" />
          <text class="out-label" x={branchX + 18} y={y}>
            {outputs[i]}
          </text>
        </g>
      ))
    }
  </svg>
</figure>

<style>
  .value-chain {
    margin: 0 0 var(--space-2);
  }

  svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .axis,
  .tick {
    stroke: var(--rule);
    stroke-width: 1.5;
  }

  .branch {
    fill: none;
    stroke: var(--trace);
    stroke-width: 1;
    opacity: 0.55;
  }

  .out-marker {
    fill: var(--signal);
  }

  .stage-n {
    fill: var(--signal);
    font-family: var(--font-display);
    font-variation-settings: var(--vf-label);
    font-size: 12px;
    letter-spacing: 1.4px;
    text-anchor: middle;
  }

  .stage-label {
    fill: var(--trace);
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 88, 'wght' 560;
    font-size: 13px;
    text-anchor: middle;
  }

  .out-label {
    fill: var(--text);
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 88, 'wght' 560;
    font-size: 13px;
    dominant-baseline: central;
  }
</style>
