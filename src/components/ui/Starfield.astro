---
// A small seeded PRNG (mulberry32) so the star field is deterministic across
// builds — identical output for every visitor, no per-request randomness.
function mulberry32(seed: number) {
  let a = seed;
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

function stars(count: number, seed: number, rMin: number, rMax: number, oMin: number, oMax: number) {
  const rand = mulberry32(seed);
  return Array.from({ length: count }, () => ({
    cx: rand() * 1000,
    cy: rand() * 1000,
    r: rMin + rand() * (rMax - rMin),
    o: oMin + rand() * (oMax - oMin),
  }));
}

// viewBox is 1000 units; real rendered diameters land in the ~1-5px range at
// typical viewport widths (a unit is roughly 1.6-2px on a 1400-1700px-wide
// screen) — stars must read as pinpricks, not blobs.
const farStars = stars(45, 1, 1.2, 2.2, 0.12, 0.28);
const nearStars = stars(28, 2, 1.8, 3, 0.18, 0.4);
---

<div class="starfield" aria-hidden="true">
  <div class="glow glow-a"></div>
  <div class="glow glow-b"></div>

  <svg class="stars-far" viewBox="0 0 1000 1000" preserveAspectRatio="xMidYMid slice">
    {farStars.map((s) => <circle cx={s.cx} cy={s.cy} r={s.r} opacity={s.o} style={`--peak:${s.o}`} />)}
  </svg>

  <svg class="stars-near" viewBox="0 0 1000 1000" preserveAspectRatio="xMidYMid slice">
    {nearStars.map((s) => <circle cx={s.cx} cy={s.cy} r={s.r} opacity={s.o} style={`--peak:${s.o}`} />)}
  </svg>
</div>

<style>
  .starfield {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    background: var(--bg);
  }

  .stars-far,
  .stars-near {
    position: absolute;
    inset: -10% -10% -30% -10%;
    width: 120%;
    height: 140%;
  }

  .stars-far circle,
  .stars-near circle {
    fill: var(--text);
    animation: twinkle 7s ease-in-out infinite;
  }

  .stars-far circle {
    filter: blur(0.3px);
  }

  .stars-near circle:nth-child(odd) {
    animation-delay: -2.5s;
  }

  .glow {
    position: absolute;
    width: 55vmax;
    height: 55vmax;
    border-radius: 50%;
    background: radial-gradient(circle, var(--accent-soft) 0%, transparent 68%);
    filter: blur(30px);
  }

  .glow-a {
    top: -18vmax;
    right: -12vmax;
  }

  .glow-b {
    bottom: -22vmax;
    left: -14vmax;
    opacity: 0.7;
  }

  @keyframes twinkle {
    0%,
    100% {
      opacity: calc(var(--peak) * 0.5);
    }
    50% {
      opacity: var(--peak);
    }
  }

  /* CSS-only scroll-driven parallax where supported; a fully static field
     everywhere else (including prefers-reduced-motion, handled globally by
     motion.css, which this rule is deliberately layered on top of). */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .stars-far {
        animation: parallax-far linear;
        animation-timeline: scroll(root);
      }

      .stars-near {
        animation: parallax-near linear;
        animation-timeline: scroll(root);
      }

      @keyframes parallax-far {
        to {
          transform: translateY(-4%);
        }
      }

      @keyframes parallax-near {
        to {
          transform: translateY(-9%);
        }
      }
    }
  }
</style>
