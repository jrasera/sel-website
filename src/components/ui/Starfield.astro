---
// A small seeded PRNG (mulberry32) so the star field is deterministic across
// builds — identical output for every visitor, no per-request randomness.
function mulberry32(seed: number) {
  let a = seed;
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

function stars(count: number, seed: number, rMin: number, rMax: number) {
  const rand = mulberry32(seed);
  return Array.from({ length: count }, () => ({
    cx: rand() * 100,
    cy: rand() * 100,
    r: rMin + rand() * (rMax - rMin),
    o: 0.35 + rand() * 0.55,
  }));
}

const farStars = stars(70, 1, 0.25, 0.55);
const nearStars = stars(45, 2, 0.5, 1);
---

<div class="starfield" aria-hidden="true">
  <div class="glow glow-a"></div>
  <div class="glow glow-b"></div>

  <svg class="stars-far" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice">
    {farStars.map((s) => <circle cx={s.cx} cy={s.cy} r={s.r} opacity={s.o} />)}
  </svg>

  <svg class="stars-near" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice">
    {nearStars.map((s) => <circle cx={s.cx} cy={s.cy} r={s.r} opacity={s.o} />)}
  </svg>
</div>

<style>
  .starfield {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    background: var(--bg);
  }

  .stars-far,
  .stars-near {
    position: absolute;
    inset: -10% -10% -30% -10%;
    width: 120%;
    height: 140%;
  }

  .stars-far circle {
    fill: var(--text);
    filter: blur(0.6px);
    animation: twinkle 7s ease-in-out infinite;
  }

  .stars-near circle {
    fill: var(--text);
    animation: twinkle 5s ease-in-out infinite;
  }

  .stars-near circle:nth-child(odd) {
    animation-delay: -2.5s;
  }

  .glow {
    position: absolute;
    width: 55vmax;
    height: 55vmax;
    border-radius: 50%;
    background: radial-gradient(circle, var(--accent-soft) 0%, transparent 68%);
    filter: blur(30px);
  }

  .glow-a {
    top: -18vmax;
    right: -12vmax;
  }

  .glow-b {
    bottom: -22vmax;
    left: -14vmax;
    opacity: 0.7;
  }

  @keyframes twinkle {
    0%,
    100% {
      opacity: 0.3;
    }
    50% {
      opacity: 1;
    }
  }

  /* CSS-only scroll-driven parallax where supported; a fully static field
     everywhere else (including prefers-reduced-motion, handled globally by
     motion.css, which this rule is deliberately layered on top of). */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .stars-far {
        animation: parallax-far linear;
        animation-timeline: scroll(root);
      }

      .stars-near {
        animation: parallax-near linear;
        animation-timeline: scroll(root);
      }

      @keyframes parallax-far {
        to {
          transform: translateY(-4%);
        }
      }

      @keyframes parallax-near {
        to {
          transform: translateY(-9%);
        }
      }
    }
  }
</style>
