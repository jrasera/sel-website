---
interface Props {
  label?: string;
}

const { label = 'Illustrative cumulative cash-flow curve' } = Astro.props;
---

<div class="data-motif" role="img" aria-label={label}>
  <svg viewBox="0 0 400 320" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
    <line x1="24" y1="160" x2="376" y2="160" class="axis" />
    <path
      class="curve"
      d="M 24 180 C 90 230, 130 260, 170 250 C 220 236, 240 150, 280 110 C 320 74, 350 60, 376 44"
      fill="none"
    />
    <circle class="marker" cx="376" cy="44" r="5" />
  </svg>
  <span class="mono-label caption">{label}</span>
</div>

<style>
  .data-motif {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-2);
  }

  svg {
    width: 100%;
    height: auto;
    max-height: 100%;
  }

  .axis {
    stroke: var(--line);
    stroke-width: 1;
  }

  .curve {
    stroke: var(--accent);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 520;
    stroke-dashoffset: 0;
    animation: draw-curve 1s ease-out;
  }

  .marker {
    fill: var(--accent);
    opacity: 1;
    animation: fade-in 0.3s ease-out 0.85s backwards;
  }

  @keyframes draw-curve {
    from {
      stroke-dashoffset: 520;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .caption {
    text-align: center;
  }
</style>
