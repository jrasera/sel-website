---
interface Props {
  label?: string;
}

const { label = 'Exploring the space of possible futures' } = Astro.props;

// Seeded PRNG (mulberry32, same as Starfield.astro) so the ensemble is
// deterministic across builds — identical output for every visitor.
function mulberry32(seed: number) {
  let a = seed;
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = mulberry32(11);
const N = 16;
const originX = 24;
const originY = 160;
const endX = 400;
const MAX_SPREAD = 130;

const paths = Array.from({ length: N }, () => {
  const spread = (rand() - 0.5) * 2 * MAX_SPREAD;
  const endY = originY + spread;
  const curveBias = (rand() - 0.5) * 50;
  const c1x = originX + (endX - originX) * (0.26 + rand() * 0.12);
  const c1y = originY + spread * 0.1 + curveBias;
  const c2x = originX + (endX - originX) * (0.62 + rand() * 0.12);
  const c2y = endY - spread * 0.05;
  const dist = Math.abs(spread);
  const roll = rand();
  const color = roll < 0.14 ? 'accent' : roll < 0.26 ? 'accent-warm' : 'muted';
  const peak = color === 'muted' ? 0.14 + 0.3 * (1 - dist / MAX_SPREAD) : 0.75 + rand() * 0.25;
  return {
    d: `M ${originX} ${originY} C ${c1x} ${c1y}, ${c2x} ${c2y}, ${endX} ${endY}`,
    endX,
    endY,
    color,
    peak,
    width: color === 'muted' ? 1 + 0.7 * (1 - dist / MAX_SPREAD) : 1.8,
    duration: 5 + rand() * 4,
    delay: -rand() * 9,
  };
});
---

<div class="future-fan" role="img" aria-label={label}>
  <svg viewBox="0 0 400 320" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <circle class="origin" cx={originX} cy={originY} r="3.5" />
    {
      paths.map((p) => (
        <path
          class:list={['ray', `ray-${p.color}`]}
          d={p.d}
          fill="none"
          stroke-width={p.width}
          style={`--peak:${p.peak}; animation-duration:${p.duration}s; animation-delay:${p.delay}s`}
        />
      ))
    }
    {
      paths.map((p) => (
        <circle
          class:list={['end-dot', `end-dot-${p.color}`]}
          cx={p.endX}
          cy={p.endY}
          r={p.color === 'muted' ? 1.8 : 2.6}
          style={`--peak:${p.peak}; animation-duration:${p.duration}s; animation-delay:${p.delay}s`}
        />
      ))
    }
  </svg>
  <span class="mono-label caption">{label}</span>
</div>

<style>
  .future-fan {
    position: relative;
    width: 100%;
    height: 100%;
  }

  svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .origin {
    fill: var(--accent);
    opacity: 0.8;
  }

  .ray {
    stroke-linecap: round;
    opacity: calc(var(--peak) * 0.45);
    animation: ensemble-cycle linear infinite;
  }

  .ray-muted {
    stroke: var(--muted);
  }

  .ray-accent {
    stroke: var(--accent);
  }

  .ray-accent-warm {
    stroke: var(--accent-warm);
  }

  .end-dot {
    opacity: calc(var(--peak) * 0.45);
    animation: ensemble-cycle linear infinite;
  }

  .end-dot-muted {
    fill: var(--muted);
  }

  .end-dot-accent {
    fill: var(--accent);
  }

  .end-dot-accent-warm {
    fill: var(--accent-warm);
  }

  @keyframes ensemble-cycle {
    0%,
    100% {
      opacity: calc(var(--peak) * 0.12);
    }
    50% {
      opacity: var(--peak);
    }
  }

  .caption {
    position: absolute;
    left: var(--space-2);
    bottom: var(--space-2);
  }
</style>
