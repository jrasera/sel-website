---
interface Props {
  label?: string;
}

const { label } = Astro.props;
const TICKS = 21;
---

<div class="axis-divider">
  {label && <span class="mono-label axis-label">{label}</span>}
  <svg class="ticks" viewBox="0 0 400 12" preserveAspectRatio="none" aria-hidden="true">
    <line x1="0" y1="6" x2="400" y2="6" class="rule" />
    {
      Array.from({ length: TICKS }, (_, i) => (i * 400) / (TICKS - 1)).map((x) => (
        <line x1={x} y1="2" x2={x} y2="10" class="tick" />
      ))
    }
  </svg>
</div>

<style>
  .axis-divider {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .axis-label {
    white-space: nowrap;
  }

  .ticks {
    flex: 1;
    height: 12px;
    display: block;
    overflow: visible;
  }

  .rule {
    stroke: var(--line);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .tick {
    stroke: var(--line);
    stroke-width: 1;
    opacity: 0.55;
    vector-effect: non-scaling-stroke;
  }
</style>
