---
import type { CollectionEntry } from 'astro:content';

interface Props {
  publication: CollectionEntry<'publications'>;
}

const { publication } = Astro.props;
const { data } = publication;

const typeLabels: Record<string, string> = {
  'journal-article': 'Journal article',
  preprint: 'Preprint',
  thesis: 'Thesis',
};

const href = data.link.kind === 'download' ? data.link.file : data.link.url;
---

<li class="entry">
  <span class="label type">{typeLabels[data.type]}</span>
  <h3><a href={href}>{data.title}</a></h3>
  <p class="meta">
    {data.authors.join(', ')} · {data.venue ? `${data.venue} · ` : ''}{data.year}
  </p>
</li>

<style>
  /* Hairline-ruled entry, in the same idiom as every other list on the site. */
  .entry {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
    padding: 22px 2px;
    border-bottom: 1px solid var(--rule);
  }

  .type {
    color: var(--signal);
  }

  .entry h3 {
    font-size: 1.1rem;
    font-variation-settings: var(--vf-sub);
    margin: 0;
  }

  .entry h3 a {
    color: var(--text);
    text-decoration: none;
  }

  .entry h3 a:hover {
    color: var(--signal);
  }

  .meta {
    color: var(--trace);
    font-size: 0.92rem;
    margin: 0;
    max-width: 78ch;
  }

  @media (min-width: 52em) {
    .entry {
      grid-template-columns: 150px 1fr;
      gap: 8px 24px;
      align-items: baseline;
    }

    .type {
      grid-row: span 2;
    }
  }
</style>
