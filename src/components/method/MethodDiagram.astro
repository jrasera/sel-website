---
import RadialSelector from '../ui/RadialSelector.astro';

const principles = [
  {
    n: '01',
    heading: 'Frame the decision',
    description:
      "We begin by defining the decision itself: its objectives, the stakeholders it affects, and the criteria against which success will be judged, before any modelling work starts.",
  },
  {
    n: '02',
    heading: 'Model uncertainty explicitly',
    description:
      'Rather than relying on a single forecast, we represent the ranges and drivers that could plausibly shape long-horizon outcomes, and identify which uncertainties actually matter to the decision at hand.',
  },
  {
    n: '03',
    heading: 'Map the wider system',
    description:
      'Engineering decisions rarely stand alone. We connect technical architecture to operations, economics, and stakeholder interests, so a design choice is evaluated in its full context, not in isolation.',
  },
  {
    n: '04',
    heading: 'Design for change over time',
    description:
      'We distinguish what should be fixed at the outset from what can be staged, deferred, or built with the capacity to adapt as conditions become clearer.',
  },
  {
    n: '05',
    heading: 'Explore the space of possibilities',
    description:
      'Using simulation ensembles and structured scenario analysis, we compare credible alternatives across many futures rather than optimising for one assumed outcome.',
  },
  {
    n: '06',
    heading: 'Quantify the value of flexibility',
    description:
      "Where a design can adapt, we use real options analysis to determine whether that adaptability is worth its cost — turning flexibility from an intuition into a number decision-makers can act on.",
  },
  {
    n: '07',
    heading: 'Balance risk and reward',
    description:
      "We bring stakeholders' differing priorities into a shared, transparent view of trade-offs, supporting recommendations and next steps that are defensible under scrutiny.",
  },
];
---

<section aria-labelledby="principles-h" class="method-diagram-section reveal">
  <h2 id="principles-h">Seven principles</h2>
  <p class="intro">
    Every project we take on, from lunar in-situ resource utilisation to transport and energy
    infrastructure, applies the same underlying method — focused on decision quality under
    uncertainty.
  </p>
  <RadialSelector hubLabel="SEL" items={principles} size="large" />
</section>

<style>
  .method-diagram-section h2 {
    font-size: var(--step-2);
  }

  .intro {
    color: var(--muted);
    margin: 14px 0 0;
    max-width: 60ch;
  }

  .method-diagram-section :global(.radial-selector) {
    margin-top: var(--space-3);
  }
</style>
