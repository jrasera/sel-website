---
import type { CollectionEntry } from 'astro:content';
import PersonCard from './PersonCard.astro';

interface Props {
  heading: string;
  people: CollectionEntry<'people'>[];
}

const { heading, people } = Astro.props;
---

{
  people.length > 0 && (
    <section aria-labelledby={`group-${heading.replace(/\s+/g, '-').toLowerCase()}`}>
      <h2 id={`group-${heading.replace(/\s+/g, '-').toLowerCase()}`}>{heading}</h2>
      <div class="grid">
        {people.map((person) => <PersonCard person={person} />)}
      </div>
    </section>
  )
}

<style>
  h2 {
    font-size: 1.5rem;
    margin-bottom: 16px;
  }

  /* Rows, not a card grid: two columns of ruled rows on wide screens, one
     below. The column-gap is the only separation the rules need. */
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: var(--space-3);
    border-top: 1px solid var(--rule);
  }

  /* A group with one member gets a full-width rule rather than a rule that
     stops halfway across the page. */
  .grid > :global(:only-child) {
    grid-column: 1 / -1;
  }

  @media (min-width: 46em) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
