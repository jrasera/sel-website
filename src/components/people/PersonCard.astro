---
import type { CollectionEntry } from 'astro:content';

interface Props {
  person: CollectionEntry<'people'>;
}

const { person } = Astro.props;
const { data, id } = person;
---

{/* A ruled row, not a bordered card: portrait, name, role, on one hairline. */}
<a href={`/people/${id}/`} class="person">
  <span class="photo" aria-hidden={data.photo ? undefined : 'true'}>
    {
      data.photo ? (
        <img src={data.photo} alt={data.photoAlt ?? ''} width="72" height="72" />
      ) : (
        <span class="label initials">{data.initials}</span>
      )
    }
  </span>
  <span class="who">
    <span class="name">{data.name}</span>
    <span class="role">{data.role}</span>
  </span>
</a>

<style>
  .person {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 2px;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: var(--text);
    transition: color 0.18s ease;
  }

  .person:hover {
    color: var(--signal);
  }

  .photo {
    width: 60px;
    height: 60px;
    flex: none;
    overflow: hidden;
    background: var(--lift);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 0.2s ease;
  }

  .person:hover .photo img {
    filter: none;
  }

  .initials {
    color: var(--trace);
  }

  .who {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .name {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 100, 'wght' 580;
    font-size: 1.02rem;
    line-height: 1.2;
  }

  .role {
    color: var(--trace);
    font-size: 0.9rem;
  }
</style>
