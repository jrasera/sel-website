---
type ToolData =
  | { state: 'none' }
  | { state: 'in-development'; note?: string }
  | { state: 'coming-soon'; note?: string }
  | { state: 'embed'; embedUrl: string; title: string }
  | { state: 'link-out'; url: string; label: string };

interface Props {
  tool: ToolData;
}

const { tool } = Astro.props;
---

{
  tool.state === 'in-development' && (
    <section aria-labelledby="tool-h" class="tool-slot">
      <h2 id="tool-h">Tool</h2>
      <div class="status-card status-development">
        <span class="mono-label">In development</span>
        <p>{tool.note ?? 'An interactive tool is in development as part of this research.'}</p>
      </div>
    </section>
  )
}
{
  tool.state === 'coming-soon' && (
    <section aria-labelledby="tool-h" class="tool-slot">
      <h2 id="tool-h">Tool</h2>
      <div class="status-card status-coming-soon">
        <span class="mono-label">Coming soon</span>
        <p>{tool.note ?? 'An interactive tool is planned for this project.'}</p>
      </div>
    </section>
  )
}
{
  tool.state === 'link-out' && (
    <section aria-labelledby="tool-h" class="tool-slot">
      <h2 id="tool-h">Tool</h2>
      <a href={tool.url} class="link-out-card">
        {tool.label} <span aria-hidden="true">↗</span>
      </a>
    </section>
  )
}
{
  tool.state === 'embed' && (
    <section aria-labelledby="tool-h" class="tool-slot">
      <h2 id="tool-h">Tool</h2>
      <div class="embed-frame">
        <iframe src={tool.embedUrl} title={tool.title} loading="lazy" />
      </div>
    </section>
  )
}

<style>
  .tool-slot h2 {
    font-size: var(--step-2);
  }

  .status-card {
    margin-top: 18px;
    border-radius: 16px;
    padding: 26px;
    border: 1px dashed var(--line);
    background: var(--bg2);
  }

  .status-card p {
    color: var(--muted);
    margin: 10px 0 0;
  }

  .status-coming-soon .mono-label {
    color: var(--accent);
  }

  .link-out-card {
    margin-top: 18px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--accent);
    color: var(--on-accent);
    padding: 15px 24px;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    font-family: var(--font-display);
  }

  .embed-frame {
    margin-top: 18px;
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 16 / 10;
  }

  .embed-frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
