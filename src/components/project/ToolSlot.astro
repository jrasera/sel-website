---
interface EmbedItem {
  title: string;
  embedUrl: string;
  description?: string;
  sourceUrl?: string;
}

type ToolData =
  | { state: 'none' }
  | { state: 'in-development'; note?: string }
  | { state: 'coming-soon'; note?: string }
  | { state: 'embed'; intro?: string; items: EmbedItem[] }
  | { state: 'link-out'; url: string; label: string };

interface Props {
  tool: ToolData;
}

const { tool } = Astro.props;
const statusNote =
  tool.state === 'in-development'
    ? (tool.note ?? 'An interactive tool is in development as part of this research.')
    : tool.state === 'coming-soon'
      ? (tool.note ?? 'An interactive tool is planned for this project.')
      : '';
---

{
  (tool.state === 'in-development' || tool.state === 'coming-soon') && (
    /* Status is carried by a marker and a rule, not by a dashed card. */
    <section aria-labelledby="tool-h" class="tool-slot">
      <h2 id="tool-h">Tool</h2>
      <div class="status">
        <span class="label status-label">
          {tool.state === 'in-development' ? 'In development' : 'Coming soon'}
        </span>
        <p>{statusNote}</p>
      </div>
    </section>
  )
}
{
  tool.state === 'link-out' && (
    <section aria-labelledby="tool-h" class="tool-slot">
      <h2 id="tool-h">Tool</h2>
      <a href={tool.url} class="btn">
        {tool.label} <span class="arw" aria-hidden="true">↗</span>
      </a>
    </section>
  )
}
{
  tool.state === 'embed' && (
    <section aria-labelledby="tool-h" class="tool-slot">
      <h2 id="tool-h">{tool.items.length > 1 ? 'Models' : 'Tool'}</h2>
      {tool.intro && <p class="intro">{tool.intro}</p>}
      <ol class="models">
        {tool.items.map((item, i) => (
          <li>
            <div class="model-head">
              <span class="model-n label">{String(i + 1).padStart(2, '0')}</span>
              <div class="model-meta">
                <h3>{item.title}</h3>
                {item.description && <p>{item.description}</p>}
              </div>
            </div>
            <div class="embed-frame">
              <iframe
                src={item.embedUrl}
                title={item.title}
                loading="lazy"
                allowfullscreen
              />
            </div>
            <p class="model-links">
              <a href={item.embedUrl} target="_blank" rel="noopener">
                Open full screen <span class="arw" aria-hidden="true">↗</span>
              </a>
              {item.sourceUrl && (
                <a href={item.sourceUrl} target="_blank" rel="noopener">
                  Author's copy <span class="arw" aria-hidden="true">↗</span>
                </a>
              )}
            </p>
          </li>
        ))}
      </ol>
    </section>
  )
}

<style>
  .tool-slot h2 {
    font-size: var(--step-2);
  }

  .status {
    margin-top: 18px;
    padding-left: 18px;
    border-left: 2px solid var(--signal);
  }

  .status-label {
    color: var(--signal);
  }

  .status p {
    color: var(--trace);
    margin: 8px 0 0;
    max-width: 62ch;
  }

  .tool-slot .btn {
    margin-top: 18px;
  }

  .intro {
    color: var(--trace);
    margin: 18px 0 0;
    max-width: 62ch;
  }

  /* Each model reads as a numbered entry on a rule, matching the task and
     milestone lists elsewhere on the page. */
  .models {
    list-style: none;
    margin: 34px 0 0;
    padding: 0;
    display: grid;
    gap: 46px;
  }

  .model-head {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 16px;
    padding-top: 18px;
    border-top: 1px solid var(--rule);
  }

  .model-n {
    color: var(--signal);
  }

  .model-meta h3 {
    font-size: 1.2rem;
    margin: 0;
  }

  .model-meta p {
    color: var(--trace);
    margin: 8px 0 0;
    max-width: 62ch;
  }

  .embed-frame {
    margin-top: 20px;
    border: 1px solid var(--rule);
    overflow: hidden;
    aspect-ratio: 16 / 10;
  }

  .embed-frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .model-links {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    margin: 12px 0 0;
  }

  .model-links a {
    color: var(--signal);
    text-decoration: none;
    font-family: var(--font-display);
    font-variation-settings: var(--vf-ui);
    font-size: 0.9rem;
  }

  .model-links a:hover {
    text-decoration: underline;
  }

  @media (max-width: 720px) {
    .model-head {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .embed-frame {
      aspect-ratio: 3 / 4;
    }
  }
</style>
