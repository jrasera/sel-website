---
import AxisDivider from '../ui/AxisDivider.astro';

const groups = [
  { href: 'http://strategic.mit.edu', label: 'MIT Strategic Engineering' },
  { href: 'https://cesun.org/', label: 'Council of Engineering Systems Universities' },
  { href: 'https://www.imperial.ac.uk/systems-engineering-innovation', label: 'Centre for Systems Engineering & Innovation' },
  { href: 'https://www.imperial.ac.uk/process-systems-engineering', label: 'Sargent Centre for Process Systems Engineering' },
  { href: 'https://www.imperial.ac.uk/engineering/departments/earth-science/research/research-groups/amprg/', label: 'Advanced Mineral Processing Research Group' },
];
---

<section aria-labelledby="keylinks-h" class="reveal">
  <AxisDivider label="Related" />
  <h2 id="keylinks-h">Related groups &amp; communities</h2>
  <ul class="rows">
    {
      groups.map((g, i) => (
        <li>
          <a href={g.href}>
            <span class="label n">{String(i + 1).padStart(2, '0')}</span>
            <span class="t">{g.label}</span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  h2 {
    font-size: var(--step-2);
    margin-top: var(--space-2);
  }

  /* Hairline-ruled rows, matching the project and resource lists — the pill
     chips these replaced were the card idiom in miniature. */
  .rows {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
  }

  .rows li {
    border-bottom: 1px solid var(--rule);
  }

  .rows li:first-child {
    border-top: 1px solid var(--rule);
  }

  .rows a {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding: 15px 2px;
    text-decoration: none;
    color: var(--text);
    transition: color 0.18s ease;
  }

  .rows a:hover {
    color: var(--signal);
  }

  .n {
    color: var(--trace);
  }

  .t {
    flex: 1;
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 104, 'wght' 560;
    font-size: 1.02rem;
  }

  .arrow {
    color: var(--trace);
  }

  .rows a:hover .arrow {
    color: var(--signal);
  }
</style>
