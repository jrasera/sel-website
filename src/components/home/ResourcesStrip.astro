---
const resources = [
  { href: '/projects/', title: 'Projects', description: 'Impactful system-design tools applied with partners worldwide, across aerospace, energy, resource extraction, and transportation.' },
  { href: '/publications/', title: 'Publications', description: 'Methods and applications across leading design, systems, and economics journals.' },
  { href: '/people/', title: 'People', description: 'A team drawn from across continents, with a wide range of backgrounds and expertise.' },
  { href: '/opportunities/', title: 'Opportunities', description: 'PhD study in resilient and sustainable infrastructure systems design and analysis.' },
];
---

<section aria-labelledby="resources-h" class="paper reveal">
  <div class="inner">
    <span class="label eyebrow">Find your way in</span>
    <h2 id="resources-h">Resources</h2>
    <div class="rows">
      {
        resources.map((r, i) => (
          <a href={r.href} class="row">
            <span class="label row-n">{String(i + 1).padStart(2, '0')}</span>
            <span class="row-body">
              <h3>{r.title}</h3>
              <p>{r.description}</p>
            </span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Shares the paper band with the partner strip directly above it: the two
     sections are one continuous light interruption, not two. */
  .inner {
    padding: var(--space-2) var(--space-1) var(--space-4);
  }

  .eyebrow {
    color: var(--paper-trace);
  }

  h2 {
    color: var(--paper-ink);
    font-size: var(--step-3);
    margin-top: 14px;
  }

  .rows {
    margin-top: var(--space-2);
    border-top: 1px solid var(--paper-rule);
  }

  .row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-2);
    padding: 24px 4px;
    text-decoration: none;
    border-bottom: 1px solid var(--paper-rule);
    transition: gap 0.2s ease;
  }

  .row:hover,
  .row:focus-visible {
    gap: calc(var(--space-2) + 6px);
  }

  .row-n {
    color: var(--paper-trace);
  }

  .row-body h3 {
    color: var(--paper-ink);
    font-size: 1.25rem;
    font-variation-settings: var(--vf-sub);
  }

  .row-body p {
    color: var(--paper-trace);
    font-size: 0.95rem;
    margin: 6px 0 0;
    max-width: 62ch;
  }

  .arrow {
    color: var(--paper-ink);
    font-size: 1.1rem;
  }

  @media (max-width: 40em) {
    .row {
      grid-template-columns: auto 1fr;
    }

    .arrow {
      display: none;
    }
  }
</style>
