---
const resources = [
  { href: '/projects/', title: 'Projects', description: 'Impactful system-design tools applied with partners worldwide, across aerospace, energy, resource extraction, and transportation.' },
  { href: '/publications/', title: 'Publications', description: 'Methods and applications across leading design, systems, and economics journals.' },
  { href: '/people/', title: 'People', description: 'A team drawn from across continents, with a wide range of backgrounds and expertise.' },
  { href: '/opportunities/', title: 'Opportunities', description: 'PhD study in resilient and sustainable infrastructure systems design and analysis.' },
];
---

<section aria-labelledby="resources-h" class="surface-warm reveal">
  <div class="inner">
    <span class="mono-label eyebrow">Find your way in</span>
    <h2 id="resources-h">Resources</h2>
    <div class="rows">
      {
        resources.map((r, i) => (
          <a href={r.href} class="row">
            <span class="row-n mono-label">{String(i + 1).padStart(2, '0')}</span>
            <span class="row-body">
              <h3>{r.title}</h3>
              <p>{r.description}</p>
            </span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .inner {
    padding: var(--space-4) var(--space-1);
  }

  .eyebrow {
    color: var(--surface-warm-muted);
  }

  h2 {
    color: var(--surface-warm-text);
    font-size: var(--step-3);
    margin-top: 14px;
  }

  .rows {
    margin-top: var(--space-3);
    border-top: 1px solid rgba(23, 20, 15, 0.14);
  }

  .row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-2);
    padding: 24px 4px;
    text-decoration: none;
    border-bottom: 1px solid rgba(23, 20, 15, 0.14);
    transition: gap 0.2s ease;
  }

  .row:hover,
  .row:focus-visible {
    gap: calc(var(--space-2) + 6px);
  }

  .row:focus-visible {
    outline: 2px solid var(--surface-warm-text);
    outline-offset: -2px;
  }

  .row-n {
    color: var(--surface-warm-muted);
  }

  .row-body h3 {
    color: var(--surface-warm-text);
    font-size: 1.2rem;
  }

  .row-body p {
    color: var(--surface-warm-muted);
    font-size: 0.92rem;
    margin: 6px 0 0;
  }

  .arrow {
    color: var(--surface-warm-text);
    font-size: 1.1rem;
  }

  @media (max-width: 40em) {
    .row {
      grid-template-columns: auto 1fr;
    }

    .arrow {
      display: none;
    }
  }
</style>
