---
import AxisDivider from '../ui/AxisDivider.astro';
---

<section aria-labelledby="contact-h" class="contact reveal">
  <h2 id="contact-h">Work with us</h2>
  <AxisDivider terminal />
  <p class="lede">
    For academic details or collaboration enquiries, get in touch with the lab director.
  </p>
  <a href="mailto:m.cardin@imperial.ac.uk" class="btn-key">m.cardin@imperial.ac.uk</a>
</section>

<style>
  /* The page opens on a decision point and closes on the terminal tick of the
     same axis — no panel, no gradient. */
  .contact {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: flex-start;
  }

  .contact h2 {
    font-size: var(--step-3);
    font-variation-settings: var(--vf-hero);
    letter-spacing: -0.024em;
  }

  .contact :global(.axis-divider) {
    align-self: stretch;
  }

  .lede {
    color: var(--trace);
    margin: 0;
    max-width: 52ch;
  }

  .contact .btn-key::before {
    background: var(--signal);
  }
</style>
