---
import { getCollection, getEntry } from 'astro:content';
import PartnerLogoTile from '../ui/PartnerLogoTile.astro';

const activeProjects = await getCollection('projects', (e) => e.data.status === 'active');
const slugs = [...new Set(activeProjects.flatMap((p) => p.data.partnerSlugs ?? []))];
const partners = (await Promise.all(slugs.map((slug) => getEntry('partners', slug)))).filter(
  (p) => p !== undefined
);
---

{
  partners.length > 0 && (
    /* The partner strip is why the paper band sits here: on white the logos
       need no individual tiles, and the long dark page gets its interruption. */
    <section aria-labelledby="partners-h" class="paper reveal">
      <div class="inner">
        <span class="label" id="partners-h">
          ESA programme partners
        </span>
        <ul class="partner-row">
          {partners.map((partner) => (
            <li>
              <PartnerLogoTile partner={partner} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .inner {
    padding: var(--space-3) var(--space-1) var(--space-2);
  }

  .partner-row {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--paper-rule);
    border-bottom: 1px solid var(--paper-rule);
  }

  .partner-row li {
    padding: 20px 24px;
    border-left: 1px solid var(--paper-rule);
    display: flex;
    align-items: center;
  }

  .partner-row li:nth-child(2n + 1) {
    border-left: 0;
  }

  @media (min-width: 46em) {
    .partner-row {
      grid-template-columns: repeat(4, 1fr);
    }

    .partner-row li:nth-child(2n + 1) {
      border-left: 1px solid var(--paper-rule);
    }

    .partner-row li:nth-child(4n + 1) {
      border-left: 0;
      padding-left: 0;
    }
  }
</style>
