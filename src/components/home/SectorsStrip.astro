---
const sectors = ['Aerospace & Space', 'Energy', 'Resource Extraction', 'Transportation', 'Defence'];
---

{/* Divisions on a rule, rather than sectors separated by a dim "/" glyph —
    the separator is furniture, so it should be drawn as furniture. */}
<section aria-label="Sectors" class="full-bleed sectors-section reveal">
  <div class="sectors-inner">
    <span class="label strip-label">Sectors we work across</span>
    <ul class="sector-list">
      {sectors.map((sector) => <li>{sector}</li>)}
    </ul>
  </div>
</section>

<style>
  .sectors-section {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .sectors-inner {
    padding: 0 var(--space-1);
    display: flex;
    align-items: stretch;
    flex-wrap: wrap;
  }

  .strip-label {
    display: flex;
    align-items: center;
    padding: 18px 26px 18px 0;
  }

  .sector-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    flex: 1;
  }

  .sector-list li {
    padding: 18px 26px;
    border-left: 1px solid var(--rule);
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 100, 'wght' 580;
    font-size: 0.98rem;
  }

  @media (max-width: 40em) {
    .sector-list li {
      padding: 14px 18px;
      font-size: 0.92rem;
    }
  }
</style>
