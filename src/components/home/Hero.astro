---
import DataMotif from '../ui/DataMotif.astro';
---

<section class="hero" aria-labelledby="hero-h">
  <div class="hero-copy">
    <span class="mono-label eyebrow">Imperial College London</span>
    <h1 id="hero-h">Strategic Engineering Laboratory</h1>
    <p class="standfirst">
      How do we design future-generation engineering systems that are more sustainable and
      resilient in the face of uncertainty and risk?
    </p>
    <p class="supporting">
      At the Strategic Engineering Lab (SEL) we tackle the design, deployment, and operation of
      next-generation systems — for defence, energy, resource extraction, transportation, and
      space exploration — that run for decades and demand investments of £100 million or more.
    </p>
    <div class="cta-row">
      <a href="/projects/" class="btn btn-primary">Explore our projects <span aria-hidden="true">→</span></a>
      <a href="/people/" class="btn btn-secondary">Meet the team</a>
    </div>
  </div>
  <div class="hero-visual">
    <DataMotif />
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: var(--space-3);
    align-items: center;
    padding-top: var(--space-3);
  }

  .eyebrow {
    color: var(--accent);
    font-size: 0.8rem;
  }

  .hero h1 {
    font-size: var(--step-4);
    margin: 16px 0 0;
    font-weight: 700;
  }

  .standfirst {
    font-size: var(--step-1);
    color: var(--text);
    margin: 22px 0 0;
    max-width: 40ch;
    font-weight: 500;
  }

  .supporting {
    color: var(--muted);
    margin: 20px 0 0;
    max-width: 54ch;
  }

  .cta-row {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 32px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 24px;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    font-family: var(--font-display);
    transition: filter 0.2s ease, border-color 0.2s ease;
  }

  .btn-primary {
    background: var(--accent);
    color: var(--on-accent);
  }

  .btn-primary:hover {
    filter: brightness(1.08);
  }

  .btn-secondary {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--line);
  }

  .btn-secondary:hover {
    border-color: var(--accent);
  }

  .hero-visual {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.45);
    background: var(--bg2);
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
    }
  }
</style>
