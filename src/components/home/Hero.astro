---
import FutureFan from '../ui/FutureFan.astro';
---

<section class="hero" aria-labelledby="hero-h">
  <div class="hero-backdrop">
    <FutureFan />
  </div>
  <div class="hero-copy">
    <span class="mono-label eyebrow">Imperial College London</span>
    <h1 id="hero-h">Strategic Engineering Laboratory</h1>
    <p class="standfirst">
      How do we design future-generation engineering systems that are more sustainable and
      resilient in the face of uncertainty and risk?
    </p>
    <p class="supporting">
      At the Strategic Engineering Lab (SEL) we tackle the design, deployment, and operation of
      next-generation systems — for defence, energy, resource extraction, transportation, and
      space exploration — that run for decades and demand investments of £100 million or more.
    </p>
    <div class="cta-row">
      <a href="/projects/" class="btn btn-primary">Explore our projects <span aria-hidden="true">→</span></a>
      <a href="/people/" class="btn btn-secondary">Meet the team</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: min(720px, 88vh);
    padding-top: var(--space-2);
    overflow: hidden;
  }

  .hero-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    /* The fan reads as full-bleed atmosphere, not a boxed illustration — but
       it must never sit directly behind the text column, so it's masked out
       there entirely (transparent, not just dim) and grows in past it. This
       also reads thematically: the space of futures opens up as you move
       away from the present moment the text occupies. Fixed px stops, not
       percentages: .hero-copy has a fixed 640px max-width, so the mask must
       track that in px too, not a proportion of the (much wider, and
       differently-capped) hero section — a percentage-based mask drifts out
       of sync with the text column and lets rays cross directly behind it
       on wide viewports. */
    mask-image: linear-gradient(to right, transparent 0, transparent 680px, black 900px);
    -webkit-mask-image: linear-gradient(to right, transparent 0, transparent 680px, black 900px);
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    max-width: 640px;
  }

  .eyebrow {
    color: var(--accent);
  }

  .hero h1 {
    font-size: var(--step-4);
    margin: 18px 0 0;
    font-weight: 600;
  }

  .standfirst {
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--text);
    margin: 26px 0 0;
    max-width: 38ch;
    font-weight: 500;
  }

  .supporting {
    color: var(--muted);
    margin: 22px 0 0;
    max-width: 54ch;
  }

  .cta-row {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 36px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 24px;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    font-family: var(--font-body);
    transition: filter 0.2s ease, border-color 0.2s ease;
  }

  .btn-primary {
    background: var(--accent);
    color: var(--on-accent);
  }

  .btn-primary:hover {
    filter: brightness(1.08);
  }

  .btn-secondary {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--line);
  }

  .btn-secondary:hover {
    border-color: var(--accent);
  }

  @media (max-width: 860px) {
    .hero {
      min-height: min(640px, 80vh);
    }

    .hero-backdrop {
      mask-image: linear-gradient(to bottom, transparent 0%, transparent 58%, black 88%);
      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, transparent 58%, black 88%);
    }
  }
</style>
