---
import EnsemblePlot from '../ui/EnsemblePlot.astro';
---

<section class="hero full-bleed" aria-labelledby="hero-h">
  <div class="hero-inner">
    <div class="hero-copy">
      <span class="label eyebrow">Imperial College London</span>
      <h1 id="hero-h">Strategic Engineering Laboratory</h1>
      <p class="standfirst">
        How do we design future-generation engineering systems that are more sustainable and
        resilient in the face of uncertainty and risk?
      </p>
      <p class="supporting">
        At the Strategic Engineering Lab (SEL) we tackle the design, deployment, and operation of
        next-generation systems — for defence, energy, resource extraction, transportation, and
        space exploration — that run for decades and demand investments of £100 million or more.
      </p>
      <div class="cta-row">
        <a href="/projects/" class="btn">Explore our projects <span class="arw" aria-hidden="true">→</span></a>
        <a href="/people/" class="btn-key">Meet the team</a>
      </div>
    </div>

    <div class="hero-figure">
      <EnsemblePlot />
    </div>
  </div>
</section>

<style>
  .hero-inner {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-1);
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .eyebrow {
    color: var(--signal);
  }

  .hero h1 {
    font-size: var(--step-4);
    font-variation-settings: var(--vf-hero);
    letter-spacing: -0.028em;
    max-width: 13ch;
  }

  .standfirst {
    font-size: var(--step-1);
    font-weight: 300;
    line-height: 1.4;
    color: var(--text);
    margin: 0;
    max-width: 34ch;
  }

  .supporting {
    color: var(--trace);
    margin: 0;
    max-width: 56ch;
  }

  .cta-row {
    display: flex;
    gap: 26px;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 6px;
  }

  /* Below this width the figure sits under the copy at full width; above it the
     two share the row, with the figure taking the larger share. */
  @media (min-width: 68em) {
    .hero-inner {
      grid-template-columns: minmax(340px, 0.86fr) minmax(0, 1.14fr);
      align-items: center;
      gap: var(--space-3);
    }
  }
</style>
