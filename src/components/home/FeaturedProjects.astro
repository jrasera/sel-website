---
import { getCollection } from 'astro:content';
import AxisDivider from '../ui/AxisDivider.astro';

const allFeatured = await getCollection(
  'projects',
  (entry) => entry.data.status === 'active' && entry.data.featured
);
const featured = allFeatured.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<section aria-labelledby="projects-h" class="reveal">
  <div class="section-head">
    <div>
      <h2 id="projects-h">Projects</h2>
      <p>
        Our work spans aerospace and space, energy, resource extraction, and transportation. We
        collaborate with institutions and companies around the world to develop and apply
        genuinely impactful system-design tools and processes.
      </p>
    </div>
    <a href="/projects/" class="all-link">All projects <span aria-hidden="true">→</span></a>
  </div>

  <div class="rows">
    {
      featured.map((project, i) => (
        <>
          <AxisDivider label={project.data.sectors?.[0] ?? 'Active'} />
          <a href={`/projects/${project.id}/`} class="row">
            <span class="row-n mono-label">{String(i + 1).padStart(2, '0')}</span>
            <span class="row-body">
              <h3>{project.data.title}</h3>
              <p>{project.data.summary}</p>
            </span>
            <span class="view-link">View programme <span aria-hidden="true">→</span></span>
          </a>
        </>
      ))
    }
    <AxisDivider />
  </div>
</section>

<style>
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: var(--space-2);
  }

  .section-head h2 {
    font-size: var(--step-2);
  }

  .section-head p {
    color: var(--muted);
    margin: 12px 0 0;
    max-width: 60ch;
  }

  .all-link {
    white-space: nowrap;
    text-decoration: none;
    color: var(--accent);
    font-weight: 600;
    font-family: var(--font-body);
  }

  .row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-2);
    padding: 26px 4px;
    text-decoration: none;
    color: var(--text);
  }

  .row-n {
    color: var(--accent);
    font-size: 0.9rem;
  }

  .row-body h3 {
    font-size: 1.35rem;
  }

  .row-body p {
    color: var(--muted);
    margin: 8px 0 0;
    max-width: 60ch;
  }

  .view-link {
    white-space: nowrap;
    font-family: var(--font-body);
    font-weight: 600;
    color: var(--accent);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .row:hover .view-link,
  .row:focus-visible .view-link {
    opacity: 1;
    transform: translateX(0);
  }

  .row:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 4px;
  }

  @media (max-width: 46em) {
    .row {
      grid-template-columns: auto 1fr;
    }

    .view-link {
      display: none;
    }
  }
</style>
