---
import { getCollection } from 'astro:content';

const allFeatured = await getCollection(
  'projects',
  (entry) => entry.data.status === 'active' && entry.data.featured
);
const featured = allFeatured.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<section aria-labelledby="projects-h" class="reveal">
  <div class="section-head">
    <div>
      <h2 id="projects-h">Projects</h2>
      <p>
        Our work spans aerospace and space, energy, resource extraction, and transportation. We
        collaborate with institutions and companies around the world to develop and apply
        genuinely impactful system-design tools and processes.
      </p>
    </div>
    <a href="/projects/" class="all-link">All projects →</a>
  </div>
  <div class="cards">
    {
      featured.map((project) => (
        <a href={`/projects/${project.id}/`} class="card">
          <span class="status">
            <span class="dot" aria-hidden="true" />
            Active{project.data.sectors?.[0] ? ` · ${project.data.sectors[0]}` : ''}
          </span>
          <h3>{project.data.title}</h3>
          <p>{project.data.summary}</p>
          <span class="view-link">View programme →</span>
        </a>
      ))
    }
  </div>
</section>

<style>
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }

  .section-head h2 {
    font-size: var(--step-2);
  }

  .section-head p {
    color: var(--muted);
    margin: 12px 0 0;
    max-width: 60ch;
  }

  .all-link {
    white-space: nowrap;
    text-decoration: none;
    color: var(--accent);
    font-weight: 600;
    font-family: var(--font-display);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 22px;
  }

  .card {
    text-decoration: none;
    color: var(--text);
    background: var(--bg2);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .card:hover {
    transform: translateY(-5px);
    border-color: var(--accent);
    box-shadow: 0 20px 44px rgba(0, 0, 0, 0.4);
  }

  .status {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }

  .card h3 {
    font-size: 1.25rem;
    margin: 12px 0 8px;
  }

  .card p {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0 0 16px;
  }

  .view-link {
    margin-top: auto;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--accent);
  }
</style>
