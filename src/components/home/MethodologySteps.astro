---
import RadialSelector from '../ui/RadialSelector.astro';

const steps = [
  { n: '01', heading: 'Model uncertainty', description: 'Represent the ranges and drivers that shape long-horizon outcomes.' },
  { n: '02', heading: 'Analyse risk', description: 'Quantify exposure and identify the dominant economic and technical risks.' },
  { n: '03', heading: 'Optimise design', description: 'Search for architectures and strategies robust across many futures.' },
  { n: '04', heading: 'Support decisions', description: "Give policymakers and business leaders defensible, transparent evidence." },
];
---

<section aria-label="Research approach" class="reveal">
  <RadialSelector hubLabel="SEL" items={steps} />
  <a href="/method/" class="all-link">Learn more about our method →</a>
</section>

<style>
  .all-link {
    display: block;
    margin-top: 24px;
    text-align: center;
    text-decoration: none;
    color: var(--accent);
    font-weight: 600;
    font-family: var(--font-display);
  }
</style>
