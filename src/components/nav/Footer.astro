---
import AxisDivider from '../ui/AxisDivider.astro';
---

<footer class="site-footer">
  <div class="footer-inner">
    <AxisDivider terminal />
    <div class="footer-row">
      <div class="footer-block">
        <span class="label">Strategic Engineering Laboratory</span>
        <p class="footer-address">Dyson School of Design Engineering<br />Imperial College London</p>
      </div>

      <nav aria-label="Footer" class="footer-nav">
        <a href="/projects/">Projects</a>
        <a href="/people/">People</a>
        <a href="/publications/">Publications</a>
        <a href="/opportunities/">Opportunities</a>
        <a href="/accessibility/">Accessibility statement</a>
        <a href="mailto:m.cardin@imperial.ac.uk">Contact the lab</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-3);
  }

  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-1) var(--space-3);
  }

  .footer-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: space-between;
    padding-top: var(--space-2);
  }

  .footer-address {
    color: var(--trace);
    margin: 8px 0 0;
    font-size: 0.92rem;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    align-content: flex-start;
  }

  .footer-nav a {
    text-decoration: none;
    color: var(--trace);
    font-size: 0.92rem;
    transition: color 0.18s ease;
  }

  .footer-nav a:hover {
    color: var(--text);
  }
</style>
