---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header">
  <nav aria-label="Primary" class="nav">
    <a href="/" class="wordmark">
      <svg viewBox="0 0 1548 170" role="img" aria-label="Imperial College London" fill="currentColor" class="logo" xmlns="http://www.w3.org/2000/svg"><g fill="currentColor"><polygon points="641.97,0 641.97,170 752.47,170 752.47,140.25 674.27,140.25 674.27,97.75 745.67,97.75 745.67,68.85 674.27,68.85 674.27,29.75 752.47,29.75 752.47,0"></polygon><path d="M507.7,27.45h-23.8v57.29h23.8c18.62,0,32.3-9.01,32.3-28.65C540,35.7,526.32,27.45,507.7,27.45 M509.4,112.2h-25.5V170h-32.3V0h57.8C545.65,0,574,16.42,574,56.1C574,95.2,545.44,112.2,509.4,112.2"></path><polygon points="1032.98,0 1032.98,29.75 1072.93,29.75 1072.93,140.25 1032.98,140.25 1032.98,170 1145.18,170 1145.18,140.25 1105.23,140.25 1105.23,29.75 1145.18,29.75 1145.18,0"></polygon><path d="M924.62,52.7c0,20.48-11.9,26.94-32.3,26.94h-27.2V27.46h27.2C914.46,27.46,924.62,35.7,924.62,52.7 M958.62,52.7c0-39.68-27.2-52.7-62.9-52.7h-62.9v170h32.3v-62.9h27.2c1.49,0,2.97-0.03,4.44-0.08L929.67,170h35.79l-36.51-69.72C946.71,92.39,958.62,77.23,958.62,52.7"></path><path d="M1286.9,30.16l23.24,74.98h-46.49L1286.9,30.16z M1265.65,0l-56.1,170h34l11.59-37.4h63.51l11.59,37.4h34l-56.1-170H1265.65z"></path><polygon points="1437.16,0 1437.16,170 1547.94,170 1547.94,140.25 1469.46,140.25 1469.46,0"></polygon><polygon points="323.53,0 282.73,99.96 241.93,0 196.03,0 196.03,170 226.63,170 226.63,42.9 265.73,132.6 267.43,132.6 298.03,132.6 299.73,132.6 338.83,42.9 338.83,170 369.43,170 369.43,0"></polygon><polygon points="0.06,0 0.06,29.75 40.01,29.75 40.01,140.25 0.06,140.25 0.06,170 112.26,170 112.26,140.25 72.31,140.25 72.31,29.75 112.26,29.75 112.26,0"></polygon></g></svg>
      <span class="divider" aria-hidden="true"></span>
      <span class="name-block">
        <span class="name">Strategic Engineering Laboratory</span>
        <span class="mono-label">Dyson School of Design Engineering</span>
      </span>
    </a>

    <ul class="nav-list">
      <li>
        <a href="/" aria-current={isActive('/') && currentPath === '/' ? 'page' : undefined} class:list={{ active: currentPath === '/' }}>
          Home
        </a>
      </li>
      <li>
        <a href="/method/" aria-current={isActive('/method') ? 'page' : undefined} class:list={{ active: isActive('/method') }}>
          Method
        </a>
      </li>
      <li class="dropdown">
        <details>
          <summary aria-current={isActive('/projects') ? 'page' : undefined} class:list={{ active: isActive('/projects') }}>
            Projects
          </summary>
          <ul class="dropdown-menu" role="menu" aria-label="Projects">
            <li role="none"><a role="menuitem" href="/projects/">All active projects</a></li>
            <li role="none"><a role="menuitem" href="/projects/past/">Past projects</a></li>
          </ul>
        </details>
      </li>
      <li>
        <a href="/people/" aria-current={isActive('/people') ? 'page' : undefined} class:list={{ active: isActive('/people') }}>
          People
        </a>
      </li>
      <li>
        <a href="/publications/" aria-current={isActive('/publications') ? 'page' : undefined} class:list={{ active: isActive('/publications') }}>
          Publications
        </a>
      </li>
      <li>
        <a href="/opportunities/" aria-current={isActive('/opportunities') ? 'page' : undefined} class:list={{ active: isActive('/opportunities') }}>
          Opportunities
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(14px);
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    border-bottom: 1px solid var(--line);
  }

  .nav {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 12px var(--space-1);
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: 16px;
    text-decoration: none;
    color: var(--text);
    margin-right: auto;
  }

  .logo {
    height: 19px;
    width: auto;
    color: var(--text);
  }

  .divider {
    width: 1px;
    height: 30px;
    background: var(--line);
  }

  .name-block {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
  }

  .nav-list {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  .nav-list > li > a,
  .nav-list summary {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    color: var(--text);
    font-weight: 500;
    padding: 8px 12px;
    border-radius: 8px;
    cursor: pointer;
    list-style: none;
  }

  .nav-list summary::-webkit-details-marker {
    display: none;
  }

  .nav-list summary::after {
    content: '▾';
    font-size: 0.7rem;
    opacity: 0.7;
  }

  .nav-list > li > a:hover,
  .nav-list summary:hover {
    background: var(--bg3);
  }

  .nav-list > li > a.active::after,
  .nav-list summary.active::before {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 2px;
    height: 2px;
    background: var(--accent);
    border-radius: 2px;
  }

  .dropdown {
    position: relative;
  }

  .dropdown details[open] summary {
    background: var(--bg3);
  }

  .dropdown-menu {
    list-style: none;
    margin: 8px 0 0;
    padding: 8px;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 220px;
    background: var(--bg2);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55);
  }

  .dropdown-menu a {
    display: block;
    padding: 8px 12px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--text);
    font-size: 0.95rem;
  }

  .dropdown-menu a:hover {
    background: var(--bg3);
  }
</style>
