---
import { getCollection, getEntry } from 'astro:content';
import ListLayout from '../../layouts/ListLayout.astro';

export async function getStaticPaths() {
  const people = await getCollection('people');
  return people.map((person) => ({
    params: { slug: person.id },
    props: { person },
  }));
}

const { person } = Astro.props;
const { data } = person;

const stageLabels: Record<string, string> = {
  director: 'Director',
  postdoc: 'Postdoctoral Researcher',
  phd: 'PhD Student',
  masters: 'Masters Student',
  alumni: 'Alumnus / Alumna',
};

const projects = data.projectSlugs
  ? (await Promise.all(data.projectSlugs.map((slug) => getEntry('projects', slug)))).filter(
      (p) => p !== undefined
    )
  : [];
---

<ListLayout title={data.name} description={`${data.name} — ${data.role}, Strategic Engineering Laboratory.`} heading={data.name}>
  <div class="profile">
    <div class="photo" aria-hidden={data.photo ? undefined : 'true'}>
      {
        data.photo ? (
          <img src={data.photo} alt={data.photoAlt ?? ''} />
        ) : (
          <span class="label initials">{data.initials}</span>
        )
      }
    </div>
    <div class="profile-body">
      <p class="role">{data.role}</p>
      <span class="label stage">{stageLabels[data.careerStage]}</span>
      {data.bio && <p class="bio">{data.bio}</p>}
      {data.email && (
        <a href={`mailto:${data.email}`} class="contact-btn">Contact</a>
      )}

      {
        data.links && data.links.length > 0 && (
          <ul class="links">
            {data.links.map((link) => (
              <li>
                <a href={link.url} target="_blank" rel="noopener">
                  {link.label} <span class="arw" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }

      {
        projects.length > 0 && (
          <div class="projects">
            <span class="label">Projects</span>
            <ul>
              {projects.map((p) => (
                <li>
                  <a href={p!.data.status === 'active' ? `/projects/${p!.id}/` : '/projects/past/'}>
                    {p!.data.title} →
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>
  <p class="back-link"><a href="/people/">← Back to people</a></p>
</ListLayout>

<style>
  .profile {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .photo {
    width: 150px;
    height: 150px;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--lift);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .initials {
    font-size: 1.5rem;
    color: var(--trace);
  }

  .profile-body {
    flex: 1;
    min-width: 240px;
  }

  .role {
    font-size: var(--step-1);
    margin: 0;
  }

  .stage {
    color: var(--signal);
    display: inline-block;
    margin-top: 6px;
  }

  .bio {
    color: var(--trace);
    margin-top: 20px;
    max-width: 60ch;
  }

  .contact-btn {
    margin-top: 22px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 13px 20px;
    border-radius: var(--radius);
    background: var(--signal);
    color: var(--on-signal);
    text-decoration: none;
    font-family: var(--font-display);
    font-variation-settings: var(--vf-ui);
    font-size: 0.95rem;
  }

  /* Off-site profiles sit on one rule under the contact button. */
  .links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    margin: 26px 0 0;
    padding: 16px 0 0;
    border-top: 1px solid var(--rule);
  }

  .links a {
    color: var(--signal);
    text-decoration: none;
    font-family: var(--font-display);
    font-variation-settings: var(--vf-ui);
    font-size: 0.92rem;
  }

  .links a:hover {
    text-decoration: underline;
  }

  .projects {
    margin-top: 30px;
  }

  .projects ul {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
  }

  .projects li {
    margin-top: 6px;
  }

  .projects a {
    color: var(--signal);
    text-decoration: none;
  }

  .back-link {
    margin-top: var(--space-3);
  }

  .back-link a {
    color: var(--signal);
  }
</style>
