---
import { getCollection, getEntry } from 'astro:content';
import FeatureLayout from '../../layouts/FeatureLayout.astro';
import ProjectSection from '../../components/project/ProjectSection.astro';
import ToolSlot from '../../components/project/ToolSlot.astro';
import PartnerLogoTile from '../../components/ui/PartnerLogoTile.astro';
import ProcessFlowDiagram from '../../components/ui/ProcessFlowDiagram.astro';
import ValueChainDiagram from '../../components/ui/ValueChainDiagram.astro';

const ESA_ISRU_VALUE_CHAIN = {
  stages: [
    { n: '01', label: 'Lunar extraction' },
    { n: '02', label: 'ISRU processing' },
    { n: '03', label: 'Logistics & deployment' },
    { n: '04', label: 'Mission utilisation' },
  ],
  outputs: ['Cost', 'Revenue', 'NPV · IRR · ROI'],
};

export async function getStaticPaths() {
  const active = await getCollection('projects', (e) => e.data.status === 'active');
  return active.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;

const person = data.personSlug ? await getEntry('people', data.personSlug) : undefined;

const partners = data.partnerSlugs
  ? (await Promise.all(data.partnerSlugs.map((slug) => getEntry('partners', slug)))).filter(
      (p) => p !== undefined
    )
  : [];
---

<FeatureLayout title={data.title} description={data.summary}>
  <section aria-label="Project introduction" class="project-hero">
    <nav aria-label="Breadcrumb" class="breadcrumb label">
      <a href="/projects/">Projects</a> <span aria-hidden="true">/</span> {data.title}
    </nav>
    <h1>{data.title}</h1>
    <p class="lede">{data.summary}</p>
    <div class="tags">
      <span class="tag tag-active">Status: Active</span>
      {data.sectors?.map((sector) => <span class="tag">{sector}</span>)}
    </div>
  </section>

  {
    data.overview && (
      <ProjectSection id="overview" heading="Overview">
        {data.overview.map((paragraph) => <p>{paragraph}</p>)}
      </ProjectSection>
    )
  }

  {
    data.objectives && (
      <ProjectSection id="objectives" heading="Objectives">
        <ul class="objectives-list">
          {data.objectives.map((objective) => <li>{objective}</li>)}
        </ul>
      </ProjectSection>
    )
  }

  {
    data.workProgramme && (
      <ProjectSection id="work-programme" heading="Work programme">
        {data.workProgramme.intro && <p class="intro">{data.workProgramme.intro}</p>}
        <ol class="task-grid">
          {data.workProgramme.tasks.map((task, i) => (
            <li>
              <span class="task-n label">Task {i + 1}</span>
              <h3>{task.title}</h3>
              <p>{task.description}</p>
            </li>
          ))}
        </ol>
      </ProjectSection>
    )
  }

  {
    data.methodology && (
      <ProjectSection id="methodology" heading="Methodology & capabilities">
        {data.methodology.intro && <p class="intro">{data.methodology.intro}</p>}
        {data.methodology.showDiagram && (
          project.id === 'esa-isru' ? (
            <ValueChainDiagram stages={ESA_ISRU_VALUE_CHAIN.stages} outputs={ESA_ISRU_VALUE_CHAIN.outputs} />
          ) : (
            <ProcessFlowDiagram nodes={data.methodology.items.map((item) => ({ title: item.title }))} />
          )
        )}
        <dl class="capability-list">
          {data.methodology.items.map((item) => (
            <div class="capability-row">
              <dt>{item.title}</dt>
              <dd>{item.description}</dd>
            </div>
          ))}
        </dl>
      </ProjectSection>
    )
  }

  {
    data.statusFindings && (
      <ProjectSection id="status" heading="Programme status & findings">
        {data.statusFindings.intro && <p class="intro">{data.statusFindings.intro}</p>}
        {data.statusFindings.milestones && (
          <ol class="milestones">
            {data.statusFindings.milestones.map((m) => (
              <li class:list={{ current: m.status === 'current' }}>
                <span class="label milestone-status">
                  {m.status === 'current' ? 'Current' : m.status === 'done' ? 'Done' : 'Planned'}
                </span>
                <h3>{m.label}</h3>
                <p>{m.description}</p>
              </li>
            ))}
          </ol>
        )}
        {data.statusFindings.note && (
          <div class="findings-note">
            <p class="label">{data.statusFindings.note}</p>
          </div>
        )}
      </ProjectSection>
    )
  }

  {
    partners.length > 0 && (
      <ProjectSection id="partners" heading="Partners & support" paper>
        <ul class="partner-grid">
          {partners.map((partner) => (
            <li>
              <PartnerLogoTile partner={partner} />
            </li>
          ))}
        </ul>
      </ProjectSection>
    )
  }

  <ProjectSection id="team" heading="Team & contact">
    <div class="team-card">
      <div class="team-info">
        <h3>{data.personName}</h3>
        {person && <p class="role">{person.data.role}</p>}
        {data.collaborators && <p class="collaborators">With {data.collaborators.join(', ')}</p>}
      </div>
      {person?.data.email && (
        <a href={`mailto:${person.data.email}`} class="contact-btn">Contact</a>
      )}
    </div>
  </ProjectSection>

  <ToolSlot tool={data.tool} />
</FeatureLayout>

<style>
  .project-hero {
    padding-bottom: 0 !important;
  }

  .breadcrumb {
    margin-bottom: 18px;
    display: block;
  }

  .breadcrumb a {
    color: var(--trace);
    text-decoration: none;
  }

  .project-hero h1 {
    font-size: var(--step-3);
  }

  .lede {
    font-size: var(--step-1);
    color: var(--text);
    margin: 20px 0 0;
    max-width: 52ch;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    margin-top: 26px;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .tag {
    padding: 11px 18px;
    border-left: 1px solid var(--rule);
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 88, 'wght' 560;
    font-size: 0.86rem;
    color: var(--trace);
  }

  .tag:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .tag-active {
    color: var(--signal);
  }

  .intro {
    color: var(--trace);
    margin-bottom: 30px;
    max-width: 60ch;
  }

  .objectives-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .objectives-list li {
    padding: 20px 0 0;
    border-top: 1px solid var(--rule);
  }

  .task-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .task-grid li {
    padding: 20px 0 0;
    border-top: 1px solid var(--rule);
  }

  .task-n {
    color: var(--signal);
  }

  .task-grid h3 {
    font-size: 1.1rem;
    margin: 10px 0 8px;
  }

  .task-grid p {
    color: var(--trace);
    font-size: 0.9rem;
    margin: 0;
  }

  .capability-list {
    margin: 0;
    display: grid;
    gap: 0;
  }

  .capability-row {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 24px;
    padding: 22px 0;
    border-top: 1px solid var(--rule);
  }

  .capability-row:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .capability-row dt {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
  }

  .capability-row dd {
    margin: 0;
    color: var(--trace);
  }

  .milestones {
    list-style: none;
    margin: 0 0 40px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  /* Milestones read along one rule, with the current one marked. */
  .milestones li {
    padding: 18px 0 0;
    border-top: 1px solid var(--rule);
  }

  .milestones li.current {
    border-top-color: var(--signal);
  }

  .milestone-status {
    display: inline-block;
    color: var(--trace);
  }

  .milestones li.current .milestone-status {
    color: var(--signal);
  }

  .milestones h3 {
    font-size: 1.05rem;
    margin: 12px 0 4px;
  }

  .milestones p {
    color: var(--trace);
    font-size: 0.85rem;
    margin: 0;
  }

  .findings-note {
    padding-left: 18px;
    border-left: 1px solid var(--rule);
  }

  .findings-note p {
    max-width: 60ch;
    margin: 0;
  }

  /* Logos sit directly on the paper band, divided by hairlines rather than
     each getting its own white tile. */
  .partner-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--paper-rule);
    border-bottom: 1px solid var(--paper-rule);
  }

  .partner-grid li {
    padding: 20px 24px;
    border-left: 1px solid var(--paper-rule);
    display: flex;
    align-items: center;
  }

  .partner-grid li:nth-child(2n + 1) {
    border-left: 0;
  }

  @media (min-width: 46em) {
    .partner-grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .partner-grid li:nth-child(2n + 1) {
      border-left: 1px solid var(--paper-rule);
    }

    .partner-grid li:nth-child(4n + 1) {
      border-left: 0;
      padding-left: 0;
    }
  }

  .team-card {
    display: flex;
    gap: 20px;
    align-items: center;
    flex-wrap: wrap;
    padding: 24px 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .team-info {
    flex: 1;
    min-width: 220px;
  }

  .team-info h3 {
    font-size: 1.25rem;
  }

  .role,
  .collaborators {
    color: var(--trace);
    margin: 4px 0 0;
  }

  .contact-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 13px 20px;
    border-radius: var(--radius);
    background: var(--signal);
    color: var(--on-signal);
    text-decoration: none;
    font-family: var(--font-display);
    font-variation-settings: var(--vf-ui);
    font-size: 0.95rem;
  }

  @media (max-width: 720px) {
    .objectives-list,
    .task-grid,
    .milestones {
      grid-template-columns: 1fr 1fr;
    }

    .capability-row {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
