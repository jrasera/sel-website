---
import { getCollection } from 'astro:content';
import ListLayout from '../../layouts/ListLayout.astro';

const active = (await getCollection('projects', (e) => e.data.status === 'active')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
---

<ListLayout
  title="Projects"
  description="Active research programmes at the Strategic Engineering Laboratory, spanning aerospace and space, energy, resource extraction, and transportation."
  heading="Projects"
  intro="Our work spans a range of industry sectors and systems, in particular in aerospace and space, energy, resource extraction, and transportation. We collaborate with institutions and companies around the world to develop and apply truly impactful system-design tools and processes. Each programme maintains its own space for overview, methodology, and ongoing findings."
>
  <div class="rows">
    {
      active.map((project, i) => (
        <a href={`/projects/${project.id}/`} class="row">
          <span class="label row-n">{String(i + 1).padStart(2, '0')}</span>
          <span class="row-body">
            <span class="label status">Active{project.data.sectors?.[0] ? ` · ${project.data.sectors[0]}` : ''}</span>
            <h2>{project.data.title}</h2>
            <p>{project.data.summary}</p>
          </span>
          <span class="view-link">View programme <span aria-hidden="true">→</span></span>
        </a>
      ))
    }
  </div>
  <p class="past-link">
    Looking for earlier work? See <a href="/projects/past/">past projects</a>.
  </p>
</ListLayout>

<style>
  .rows {
    border-top: 1px solid var(--rule);
  }

  .row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-2);
    padding: 26px 2px;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: var(--text);
  }

  .row-n,
  .status {
    color: var(--signal);
  }

  .row-body h2 {
    font-size: 1.4rem;
    margin: 8px 0 0;
  }

  .row-body p {
    color: var(--trace);
    margin: 8px 0 0;
    max-width: 62ch;
  }

  .view-link {
    white-space: nowrap;
    font-family: var(--font-display);
    font-variation-settings: var(--vf-ui);
    font-size: 0.92rem;
    color: var(--signal);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .row:hover .view-link,
  .row:focus-visible .view-link {
    opacity: 1;
    transform: none;
  }

  .past-link {
    margin-top: var(--space-3);
    color: var(--trace);
  }

  .past-link a {
    color: var(--signal);
  }

  @media (max-width: 46em) {
    .row {
      grid-template-columns: auto 1fr;
    }

    .view-link {
      display: none;
    }
  }
</style>
