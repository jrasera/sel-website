---
import { getCollection } from 'astro:content';
import ListLayout from '../../../layouts/ListLayout.astro';

const past = await getCollection('projects', (e) => e.data.status === 'past');
---

<ListLayout
  title="Past Projects"
  description="Completed research programmes at the Strategic Engineering Laboratory."
  heading="Past projects"
  intro="Completed programmes from across the lab's history, carried over from our previous site."
>
  <ul class="list">
    {
      past.map((project) => (
        <li class="entry">
          <h2>{project.data.title}</h2>
          <p class="byline">{project.data.personName}</p>
          <p>{project.data.summary}</p>
          {project.data.collaborators && (
            <p class="collaborators">
              With {project.data.collaborators.join(', ')}
            </p>
          )}
        </li>
      ))
    }
  </ul>
  <p class="back-link"><a href="/projects/">← Back to active projects</a></p>
</ListLayout>

<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .entry {
    padding: 26px 2px;
    border-bottom: 1px solid var(--rule);
  }

  .entry h2 {
    font-size: 1.35rem;
  }

  .byline {
    color: var(--signal);
    font-family: var(--font-display);
    font-variation-settings: var(--vf-label);
    font-size: var(--step-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 10px 0 12px;
  }

  .entry p {
    color: var(--trace);
    margin: 0;
    max-width: 68ch;
  }

  .collaborators {
    margin-top: 10px;
    font-size: 0.9rem;
  }

  .back-link {
    margin-top: var(--space-3);
  }

  .back-link a {
    color: var(--signal);
  }
</style>
