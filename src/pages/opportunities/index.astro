---
import ListLayout from '../../layouts/ListLayout.astro';
---

<ListLayout
  title="Opportunities"
  description="PhD and MSc study opportunities at the Strategic Engineering Laboratory."
  heading="Opportunities"
  intro="SEL is looking for excellent candidates to pursue PhD studies focusing on the theme of Resilient and Sustainable Infrastructure Systems Design and Analysis at the Dyson School of Design Engineering."
>
  <section aria-labelledby="phd-h" class="block">
    <h2 id="phd-h">PhD study at SEL</h2>
    <p>
      We welcome enquiries from prospective PhD and MSc students interested in the design,
      deployment, and operation of next-generation engineering systems under deep uncertainty —
      across aerospace and space, energy, resource extraction, transportation, and defence.
    </p>
    <p>
      For academic details, project ideas, or funding routes, get in touch with the lab director.
    </p>
    <a href="mailto:m.cardin@imperial.ac.uk" class="btn">
      Contact the director <span class="arw" aria-hidden="true">→</span>
    </a>
  </section>

  <section aria-labelledby="current-h" class="block block-quiet">
    <h2 id="current-h">Current funded positions</h2>
    <p class="placeholder-note">
      No funded positions are open at this time. Specific, time-bound postings will be listed
      here — with their own deadline and project detail — when available.
    </p>
  </section>
</ListLayout>

<style>
  /* Sections divided by rules and a hanging marker, not stacked panels. */
  .block {
    max-width: 66ch;
    padding: var(--space-2) 0;
    border-top: 1px solid var(--rule);
  }

  .block h2 {
    font-size: var(--step-1);
  }

  .block p {
    color: var(--trace);
    margin-top: 14px;
  }

  .block p:first-of-type {
    margin-top: 18px;
  }

  .block .btn {
    margin-top: 24px;
  }

  .block-quiet .placeholder-note {
    color: var(--trace);
    padding-left: 18px;
    border-left: 1px solid var(--rule);
  }
</style>
